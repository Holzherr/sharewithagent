    "test": "playwright test"
  },
  "keywords": [
    "visual-feedback",
    "annotation",
    "coding-agent",
    "ai-agent",
    "code-review",
    "dom",
    "cli"
  ],
  "homepage": "https://sharewithagent.com",
  "repository": {
